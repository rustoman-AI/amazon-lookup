# Amazon LookUp backend configuration
# Copy to .env and fill in to enable LIVE Bedrock mode.
# If AWS credentials are absent, the server automatically runs in deterministic MOCK mode.

# Server
PORT=3001

# AWS / Bedrock
AWS_REGION=us-east-1
# Default primary model; fallback is us.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_FALLBACK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# AWS credentials (omit to force MOCK mode; or use a profile / IAM role instead)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Behavior
JSON_LIMIT=10mb
# Set to "true" to return 502 instead of mock when a live Bedrock call fails
DISABLE_MOCK_FALLBACK=false
