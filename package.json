{
  "name": "amazon-lookup",
  "version": "1.0.0",
  "description": "Amazon LookUp — Shoppable TV X-Ray Overlay for Fire TV & Vega OS. Fire TV frontend (React/Vite) + Bedrock vision backend that turns paused video frames into shoppable Amazon overlays.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "server:dev": "tsx watch server/index.ts",
    "server:start": "node dist/index.js",
    "server:build": "tsc --build server/tsconfig.json --force && node server/postbuild.cjs",
    "server:typecheck": "tsc --noEmit -p server/tsconfig.json",
    "server:smoke": "tsx server/smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.675.0",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "lucide-react": "^0.456.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "oxlint": "^0.11.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.10"
  },
  "engines": {
    "node": ">=18"
  }
}
